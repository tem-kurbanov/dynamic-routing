{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug MPI",
            "type": "cppdbg",
            "request": "attach",
            "processId": "${command:pickProcess}",
            "program": "/usr/bin/mpiexec",
            // "args": [
            //     "-n",
            //     "5",
            //     "${workspaceFolder}/cmake-build-Debug/MASHierarchicalSystem",
            //     "--agents",
            //     "4",
            //     "--path",
            //     "/home/tim/Work/xgrid",
            //     "--sync",
            //     "20",
            //     "--end",
            //     "12000",
            //     "--logging",
            //     "--tripinfo",
            //     "time_tripinfo.xml",
            //     ">",
            //     "${workspaceFolder}/log.log",
            //     "2>",
            //     "${workspaceFolder}/err.log"
            // ],
            // "stopAtEntry": true,
            // "cwd": "${workspaceFolder}",
            // "environment": [],
            // "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Register libstdc++14 pretty-printers",
                    "text": "-interpreter-exec console \"python sys.path.insert(0, '/usr/share/gcc-15.1.1/python/libstdcxx/v6'); import libstdcxx.v6.printers as pp; pp.register_libstdcxx_printers(None)\"",
                    "ignoreFailures": true
                }
            ],
            "miDebuggerPath": "/usr/bin/gdb"
        },
        {
            "name": "Debug MPI Peak1",
            "type": "cppdbg",
            "request": "attach",
            "processId": "${command:pickProcess}",
            "program": "/usr/bin/mpiexec",
            // "args": [
            //     "-n",
            //     "6",
            //     "${workspaceFolder}/cmake-build-release/MASHierarchicalSystem",
            //     "--agents",
            //     "5",
            //     "--path",
            //     "/home/tim/Work/scenarios/peak1",
            //     "--sync",
            //     "20",
            //     "--end",
            //     "7200",
            //     "--logging",
            //     "--tripinfo",
            //     "peak1_tripinfo.xml",
            //     ">",
            //     "${workspaceFolder}/log.log",
            //     "2>",
            //     "${workspaceFolder}/err.log"
            // ],
            // "stopAtEntry": true,
            // "cwd": "${workspaceFolder}",
            // "environment": [],
            // "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Register libstdc++14 pretty-printers",
                    "text": "-interpreter-exec console \"python sys.path.insert(0, '/usr/share/gcc-15.1.1/python/libstdcxx/v6'); import libstdcxx.v6.printers as pp; pp.register_libstdcxx_printers(None)\"",
                    "ignoreFailures": true
                }
            ],
            "miDebuggerPath": "/usr/bin/gdb"
        },
        {
            "name": "Release",
            "type": "cppdbg",
            "request": "launch",
            "program": "/usr/bin/mpiexec",
            "args": [
                "-n",
                "5",
                "${workspaceFolder}/release/MASHierarchicalSystem",
                "--agents",
                "4",
                "--path",
                "/home/tim/Work/scenarios/xgrid",
                "--sync",
                "20",
                "--end",
                "12000",
                "--logging",
                "--tripinfo",
                "time_tripinfo.xml",
                ">",
                "${workspaceFolder}/log.log",
                "2>",
                "${workspaceFolder}/err.log"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "preLaunchTask": "Build Release"
        },
        {
            "name": "Release Peak1",
            "type": "cppdbg",
            "request": "launch",
            "program": "/usr/bin/mpiexec",
            "args": [
                "-n",
                "6",
                "${workspaceFolder}/build/release/MASHierarchicalSystem",
                "--agents",
                "5",
                "--path",
                "/home/tim/Work/own/phd/phdproject/scenarios/peak1",
                "--sync",
                "20",
                "--end",
                "7200",
                "--logging",
                "--tripinfo",
                "peak1_tripinfo.xml",
                ">",
                "${workspaceFolder}/pruned_log.log",
                "2>",
                "${workspaceFolder}/pruned_err.log"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "preLaunchTask": "Build Release"
        }
    ]
}