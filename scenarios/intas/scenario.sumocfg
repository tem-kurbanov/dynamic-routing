<configuration>
	<input>
		<net-file value="reset.net.xml"/>
		<route-files value="test_typed.rou.xml"/>
		<additional-files value="InTAS.poly.xml"/>
	</input>
	<output>
		<device.emissions.probability value="1.0"/>
	</output>

	<time>
		<begin value="0"/>
		<end value="14400"/>
	</time>
	<processing>
		<route-steps value="200"/>
		<threads value="1"/>
		<ignore-junction-blocker value="15"/>
	    <time-to-teleport value="150"/>
		<time-to-teleport.highways value="150"/>
		<time-to-teleport.disable-jam value="true"/>
	</processing>
</configuration>
